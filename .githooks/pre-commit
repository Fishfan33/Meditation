#!/usr/bin/env bash
# Läuft automatisch vor jedem Commit: passt die Versionen in den HTML-Seiten und in sw.js an den
# Inhalt der App-Dateien an (siehe werkzeuge/versionen.sh).
# Aktiv, sobald einmal `git config core.hooksPath .githooks` ausgeführt wurde (Rechner des Inhabers: eingerichtet).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

# Nie Konfliktmarkierungen aus einem unvollständig zusammengeführten Stand speichern
if git diff --cached -U0 | grep -qE '^\+(<<<<<<< |=======$|>>>>>>> )'; then
  echo "Im Commit stecken noch Konfliktmarkierungen (<<<<<<< / ======= / >>>>>>>). Bitte erst auflösen." >&2
  exit 1
fi

# Nur nötig, wenn eine App-Datei im Commit steckt
git diff --cached --name-only | grep -qE '^(app\.css|config\.js|js/.*\.js|sw\.js|manifest\.json|[^/]+\.html|fonts/.*|icons/.*|klang/.*|stimme/.*)$' || exit 0

# Die Seiten und sw.js werden gleich angepasst und vorgemerkt. Andere, noch nicht vorgemerkte
# Änderungen an ihnen sollen dabei nicht versehentlich mit in den Commit rutschen.
if ! git diff --quiet -- '*.html' sw.js; then
  echo "Eine HTML-Seite oder sw.js hat Änderungen, die nicht vorgemerkt sind. Bitte erst vormerken (git add) oder verwerfen." >&2
  exit 1
fi

werkzeuge/versionen.sh --staged
git add -- *.html sw.js
